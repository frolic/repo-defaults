{
  "extends": "./tsconfig/library.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedDeclarations": false,
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src"],
  // update.ts runs only from a copy at repo-defaults/, never from node_modules.
  "exclude": ["src/update.ts"]
}
